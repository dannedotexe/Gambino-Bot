# Discord Developer Portal; niemals den echten Token committen oder in Chat posten
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
# Optional: Guild-Commands erscheinen sofort; leer = globale Registrierung
DISCORD_GUILD_ID=

# Dauerhafter Pfad auf der VM (SQLite-Datei und WAL müssen auf demselben Dateisystem liegen)
DATABASE_PATH=./data/gambino.sqlite
TIMEZONE=Europe/Vienna
CURRENCY_NAME=Gambinos-Familienguthaben
# Optionaler Mindestbetrag in Cent; leer zeigt alle Konten als auszahlbar an
PAYOUT_MINIMUM_CENTS=

# IDs als kommaseparierte Discord-Rollen-IDs; leer verweigert die jeweilige Staff-Aktion
ROLE_LEADERS=
# Voller Website-Zugriff wie die Leitung (z. B. Rang 8 und höher), ohne Verwaltung
ROLE_FULL_ACCESS=
ROLE_STAFF=
ROLE_EVENT_TEAM=
ROLE_FINANCE=
ROLE_REVIEWERS=
# Optional: Wenn gesetzt, dürfen sich nur Mitglieder (oder Staff) für Events anmelden und Rang-Anträge stellen
ROLE_MEMBERS=
# Optional: reine Leserechte für Kontostände/Auszahlungsliste (keine Buchungen)
ROLE_FINANCE_VIEWERS=
# Optional: Moderation – darf /warn, /warnings @mitglied und eigene /unwarn (ohne weitere Staff-Rechte)
ROLE_MODERATORS=
# Optional: Rolle(n) nach erfolgreicher Verifizierung
ROLE_VERIFIED=
# Optional: Discord-Benutzer-IDs mit persönlichem Vollzugriff auf Staff-Befehle
BOT_OWNER_IDS=

# Channel- und Kategorie-IDs. Leer = keine feste Ziel-Channel-Konfiguration.
CHANNEL_TICKET_CATEGORY=
CHANNEL_TICKET_LOG=
# Kategorie, in die geschlossene Tickets verschoben werden (optional)
CHANNEL_TICKET_CLOSED_CATEGORY=
CHANNEL_APPLICATION_REVIEW=
CHANNEL_RANK_REVIEW=
CHANNEL_EVENT_ANNOUNCEMENTS=
CHANNEL_EVENT_SIGNUP=
CHANNEL_ACCOUNT_PANEL=
CHANNEL_AUDIT_LOG=
CHANNEL_STATS=
CHANNEL_AUTOMOD_LOG=
CHANNEL_TICKET_PANEL=
CHANNEL_VERIFICATION_PANEL=
CHANNEL_APPLICATION_PANEL=
CHANNEL_STAFF_DASHBOARD=
CHANNEL_ACTIVITY_BOARD=
CHANNEL_EVENT_RESULTS=
CHANNEL_EVENT_LOG=
CHANNEL_GIVEAWAYS=
CHANNEL_SANCTION_LOG=
CHANNEL_FINANCE_LOG=
# Audit-Aktionen, die nur in der DB, aber nicht im Audit-Channel landen (reduziert Lärm)
AUDIT_CHANNEL_IGNORE_ACTIONS=event.participation,giveaway.entry
# Statistik-Nachricht im CHANNEL_STATS aktualisieren (Minuten, 0 = aus; ohne Finanzdaten)
STATS_CHANNEL_UPDATE_MINUTES=60
# Dashboard-Panel (/dashboard panel) automatisch aktualisieren (Minuten, 0 = aus)
DASHBOARD_PANEL_REFRESH_MINUTES=5

TICKET_COOLDOWN_SECONDS=60
TICKET_MAX_OPEN_PER_USER=2
# Maximale Nachrichten im Transkript beim Schließen (100-1000)
TICKET_TRANSCRIPT_LIMIT=500
# Optional, JSON: Kategorien mit zuständigen Rollen, z. B.
# [{"id":"support","label":"Support","roleIds":[]},{"id":"leitung","label":"Leitung","roleIds":["ROLLEN_ID"],"emoji":"👑","description":"Anliegen an die Leitung"}]
TICKET_CATEGORIES_JSON=

# Event-Erinnerungen in Minuten vor Beginn (max. 5 Werte, leer = Standard 60,15)
EVENT_REMINDER_MINUTES=60,15
# Automatisch erstellte Aktivitäts-Termine so viele Minuten nach Start schließen
EVENT_SERIES_AUTO_END_MINUTES=120
# Posts beendeter automatischer Aktivitäten löschen (Daten bleiben)
EVENT_SERIES_DELETE_ENDED=false
# Optional: Rollen, die bei Event-Ankündigungen erwähnt werden
EVENT_PING_ROLES=
# Familienkonto automatisch bei angenommener Familienbewerbung / Mitglieder-Rolle
ACCOUNT_AUTO_OPEN_FOR_MEMBERS=true

# Optional, JSON: eigene Fragen je Antragstyp (max. 5, Beschriftung max. 45 Zeichen), z. B.
# {"rang":[{"id":"name","label":"Ingame-Name","style":"short","maxLength":60},{"id":"grund","label":"Begründung","style":"paragraph","maxLength":1000}]}
APPLICATION_QUESTIONS_JSON=
# Rang-Rollen nach angenommenem Rang-Antrag vergeben (nur Leitung, nur bestätigt). Standard: aus.
RANK_ROLE_ASSIGNMENT_ENABLED=false
# JSON: freigegebene Rang-Rollen, z. B. [{"label":"Rang 2","roleId":"ROLLEN_ID"}]
RANK_ROLES_JSON=[]

# Abmeldungen, Inaktivität, Willkommen, Rangliste (alles auch auf der Website einstellbar)
ROLE_ABSENT=
CHANNEL_ABSENCES=
CHANNEL_ACTIVITY_LOG=
CHANNEL_WELCOME=
CHANNEL_LEADERBOARD=
ABSENCE_MAX_DAYS=60
ABSENCE_SHOW_REASON=false
INACTIVITY_DAYS=14
INACTIVITY_DM_ENABLED=false
INACTIVITY_ALERT_ENABLED=false
WELCOME_DM_ENABLED=false

# Events: Mindestteilnehmer (0 = aus), Prüfung X Minuten vor Start, automatische Absage; No-Shows (0 = aus)
EVENT_MIN_PARTICIPANTS=0
EVENT_MIN_CHECK_MINUTES=30
EVENT_MIN_AUTO_CANCEL=false
NOSHOW_THRESHOLD=3
NOSHOW_WINDOW_DAYS=30
NOSHOW_ACTION=alert

# Ankündigungen, öffentliche Sanktionsliste, Wochenbericht (Wochenbericht nur in einen Leitungs-Channel!)
CHANNEL_ANNOUNCEMENTS=
CHANNEL_POLLS=
CHANNEL_SANCTION_LIST=
SANCTION_LIST_SHOW_AMOUNTS=true
SANCTION_LIST_SHOW_REASONS=true
CHANNEL_WEEKLY_REPORT=
WEEKLY_REPORT_HOUR=9

# Verwarnungen (/warn). 0 = Stufe aus. Abgelaufene oder zurückgenommene Verwarnungen zählen nicht mehr.
WARN_DM_ENABLED=true
WARN_EXPIRE_DAYS=0
WARN_TIMEOUT_AT=0
WARN_TIMEOUT_MINUTES=60
WARN_ALERT_AT=0

# AutoMod ist standardmäßig aus. Bei Aktivierung: Nachrichteninhalt-Intent im Portal einschalten.
AUTOMOD_ENABLED=false
AUTOMOD_BLOCKED_TERMS=
AUTOMOD_ALLOWED_DOMAINS=discord.com,discord.gg
AUTOMOD_SPAM_COUNT=5
AUTOMOD_SPAM_WINDOW_SECONDS=8
AUTOMOD_DUPLICATE_COUNT=3
# Aktionen je Regel, kommasepariert aus: warn, delete, timeout, alert
AUTOMOD_SPAM_ACTIONS=delete,alert
AUTOMOD_DUPLICATE_ACTIONS=delete,alert
AUTOMOD_LINK_ACTIONS=delete,warn,alert
AUTOMOD_TERM_ACTIONS=delete,warn,alert
AUTOMOD_TIMEOUT_MINUTES=10
# Eskalation: so viele Verstöße im Fenster führen zusätzlich zu Timeout (0 = aus)
AUTOMOD_ESCALATION_COUNT=0
AUTOMOD_ESCALATION_WINDOW_MINUTES=30
AUTOMOD_EXEMPT_ROLES=
AUTOMOD_EXEMPT_CHANNELS=

RAID_JOIN_COUNT=10
RAID_WINDOW_SECONDS=20
# alert = Staff-Meldung; timeout = neue Mitglieder während eines Raids zeitweise stummschalten
RAID_ACTIONS=alert
RAID_TIMEOUT_MINUTES=30
RAID_ALERT_COOLDOWN_SECONDS=300
# Server-weite Nachrichtenflut (nur Staff-Meldung, 0 = aus)
FLOOD_MESSAGE_COUNT=60
FLOOD_WINDOW_SECONDS=10

# Backups (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Optionales Staff-Webdashboard (standardmäßig deaktiviert)
# Nur mit HTTPS-Reverse-Proxy und Discord-OAuth aktivieren.
DASHBOARD_ENABLED=false
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3080
DASHBOARD_PUBLIC_URL=
DISCORD_CLIENT_SECRET=
# Zufälliger Wert mit mindestens 32 Zeichen; nur direkt auf der VM hinterlegen.
DASHBOARD_SESSION_SECRET=
